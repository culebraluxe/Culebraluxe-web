<?xml version="1.0" encoding="UTF-8"?>
<form
  id="LISTING-01"
  version="1"
  title="EXCLUSIVE LISTING AGREEMENT"
  presentation="agreement"
  documentType="Listing Agreement"
  issuer="CulebraLuxe Real Estate">

  <participants>
    <participant role="SELLER" label="Seller" multiple="true"/>
    <participant role="SELLER_BROKER" label="Listing Broker"/>
  </participants>

  <field id="sellerName" label="Seller" type="text" required="true" source="person.displayName"/>
  <field id="brokerName" label="Listing Broker" type="text" required="true"/>
  <field id="property" label="Property" type="text" required="true" source="property.name"/>
  <field id="propertyLocation" label="Location" type="text" source="property.location"/>
  <field id="listPrice" label="List Price" type="money" required="true"/>
  <field id="commission" label="Commission" type="text" required="true"/>
  <field id="startDate" label="Listing Start" type="date" required="true"/>
  <field id="endDate" label="Listing End" type="date" required="true"/>
  <field id="listingType" label="Listing Type" type="select" required="true" options="Exclusive Right to Sell, Exclusive Agency"/>

  <section id="appointment" title="Appointment" editable="false">
    Seller <value field="sellerName"/> appoints <value field="brokerName"/>
    as listing broker for the property at <value field="property"/>,
    <value field="propertyLocation"/>, on an
    <value field="listingType"/> basis from
    <value field="startDate"/> through <value field="endDate"/>.
  </section>

  <section id="price" title="Price and Commission" editable="false">
    The asking price is <value field="listPrice"/>. Broker's commission is
    <value field="commission"/>, earned if a ready, willing and able buyer
    is procured during the listing term, or upon a sale to a registered
    prospect within the protection period.
  </section>

  <section id="duties" title="Broker Duties" editable="false">
    Broker shall market the property, present offers, and advise Seller in
    accordance with Puerto Rico law and CulebraLuxe practice. Seller shall
    cooperate with showings and disclose known material defects.
  </section>

  <section id="marketing" title="Marketing Authorization" editable="true">
    Describe advertising, lockbox, MLS/portal publication, and photography
    authorization.
  </section>

  <section id="additional" title="Additional Terms" editable="true">
    Additional negotiated listing terms.
  </section>

  <signatures>
    <signature-group role="SELLER" label="Seller" field="sellerName" initials="true"/>
    <signature-group role="SELLER_BROKER" label="Listing Broker" field="brokerName" initials="true"/>
  </signatures>
</form>
