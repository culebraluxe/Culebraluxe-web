# LOCAL BUILD (your Mac, free): compiles the whole application and exports the finished files, so Vercel compiles
# nothing. Runs natively on the Mac's ARM CPU and CROSS-COMPILES the server for Vercel's x86_64 Linux (all TLS is
# pure Rust, so only a C cross-compiler is needed for the crypto crate). Cache mounts keep later builds incremental.
#
#   docker build -f devops/Dockerfile.build --output type=local,dest=<dir> .
#   -> <dir>/culebraluxe (server binary, linux/amd64), <dir>/ui.js, <dir>/ui_bg.wasm
FROM --platform=$BUILDPLATFORM rust:1-bookworm AS builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc-x86-64-linux-gnu libc6-dev-amd64-cross \
    && rm -rf /var/lib/apt/lists/*
RUN rustup target add wasm32-unknown-unknown x86_64-unknown-linux-gnu \
    && cargo install wasm-bindgen-cli --version 0.2.128 --locked
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc \
    CC_x86_64_unknown_linux_gnu=x86_64-linux-gnu-gcc \
    AR_x86_64_unknown_linux_gnu=x86_64-linux-gnu-ar
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
# ONE COPY PER DIRECTORY. A multi-source COPY copies each source's CONTENTS into the destination and MERGES them:
# `COPY web middle db cli forge tests ./` collapsed web/src, db/src, cli/src and forge/src into a single /build/src,
# put middle/{model,services,workflow,apis} at /build/*, and made the LAST source's manifest the workspace root —
# /build/Cargo.toml was tests/Cargo.toml (`name = "test-harness"`), so `cargo metadata` answered "failed to find a
# workspace root" and exited 101 before compiling a line. Verified with two directories: `COPY a b ./` gives /w/afile,
# /w/bfile and one merged /w/sub; `COPY a ./a` + `COPY b ./b` gives /w/a/afile, /w/a/sub, /w/b/bfile, /w/b/sub.
# (2026-10-05: the Oct-03 layout refactor introduced the multi-source form, and the deploy died on it with NO output
# at all — see scripts/deploy-prod.sh, step 2/5, and `rust-ui-build.sh`, whose target-dir resolution folds a cargo
# failure into `2>/dev/null` under `set -euo pipefail`.)
COPY web ./web
COPY middle ./middle
COPY db ./db
COPY cli ./cli
COPY forge ./forge
COPY tests ./tests
COPY scripts/rust-ui-build.sh ./scripts/rust-ui-build.sh
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/build/target \
    mkdir -p public/rust-ui /out \
    && RUST_UI_PROFILE=release bash scripts/rust-ui-build.sh \
    && cp public/rust-ui/ui.js public/rust-ui/ui_bg.wasm /out/ \
    && cargo build --locked --release --manifest-path Cargo.toml -p web --bin web --target x86_64-unknown-linux-gnu \
    && cp target/x86_64-unknown-linux-gnu/release/web /out/culebraluxe \
    && x86_64-linux-gnu-strip /out/culebraluxe

FROM scratch AS out
COPY --from=builder /out/ /
