# Security / Auth environment contract (AUTH-08).
# NAMES ONLY — never commit real values. See docs/auth-google-setup.md.
# Other application variables (database, integrations, etc.) are configured
# separately and are not enumerated here.

# Auth.js signing secret (already set locally / in production).
AUTH_SECRET=

# Google OAuth — required for normal portal login.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: provider selection (default google).
AUTH_PROVIDER=
# Optional: issuer for the generic OIDC provider (AUTH_PROVIDER=oidc).
AUTH_ISSUER=

# Break-glass recovery (unlinked emergency path). AUTH_BREAK_GLASS_SECRET_HASH
# is the scrypt hash of the recovery secret (never the clear-text secret).
AUTH_BREAK_GLASS_ENABLED=
AUTH_BREAK_GLASS_APP_USER_ID=
AUTH_BREAK_GLASS_SECRET_HASH=

# DEV-only auth bypass. MUST be 0 / unset in production (HARDEN-01/HARDEN-04).
PORTAL_AUTH_BYPASS=

# Authorized broker signature composed only during authenticated owner issuance.
# The asset is a protected media row id; never place the signature under public/.
BROKER_SIGNATURE_ENABLED=
BROKER_SIGNATURE_APP_USER_ID=
BROKER_SIGNATURE_MEDIA_ID=
BROKER_SIGNATURE_SIGNER_NAME=
BROKER_SIGNATURE_LICENSE_NUMBER=
