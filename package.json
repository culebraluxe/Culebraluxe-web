{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test workflow_engine/tests/*.test.ts workflow_app/tests/*.test.ts",
    "test:engine": "tsx --test workflow_engine/tests/*.test.ts",
    "test:app": "tsx --test workflow_app/tests/*.test.ts",
    "test:persistence": "node --env-file=.env.local --import tsx --test-concurrency=1 --test workflow_engine/tests/persistence/*.test.ts workflow_app/tests/persistence/*.test.ts",
    "cleanse:dev": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/cleanse-dev-fixtures.ts --yes",
    "agent:runtime:dogfood": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/agent-runtime-invoke.ts",
    "agent:runtime:deepseek": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/agent-runtime-deepseek.ts",
    "agent:work": "APP_ENV=production node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/agent-work.ts",
    "agent:scheduler:install": "node scripts/agent-scheduler.mjs install",
    "agent:scheduler:status": "node scripts/agent-scheduler.mjs status",
    "agent:scheduler:run": "node scripts/agent-scheduler.mjs run",
    "agent:scheduler:stop": "node scripts/agent-scheduler.mjs stop",
    "agent:scheduler:uninstall": "node scripts/agent-scheduler.mjs uninstall"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@mux/mux-player-react": "^3.13.2",
    "@neon/config": "^1.0.1",
    "@neon/env": "^1.1.1",
    "@neondatabase/serverless": "^1.1.0",
    "@portabletext/react": "^4.0.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^5.31.1",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "next-sanity": "^13.3.1",
    "react": "^19",
    "react-dom": "^19",
    "sanity": "^5.31.1",
    "shadcn": "^4.8.0",
    "styled-components": "^6.5.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25",
      "motion": "13.0.0"
    }
  }
}
