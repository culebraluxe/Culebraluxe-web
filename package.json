    "calendar:sync:run": "node scripts/calendar-sync-agent.mjs run",
    "calendar:sync:stop": "node scripts/calendar-sync-agent.mjs stop",
    "calendar:sync:uninstall": "node scripts/calendar-sync-agent.mjs uninstall",
