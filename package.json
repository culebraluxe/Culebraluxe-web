    "bank:load:prod": "node --env-file=.env.local --import tsx scripts/bank-transaction-load.ts --env prod",
    "bank:dry-run": "node --env-file=.env.local --import tsx scripts/bank-transaction-load.ts --env dev --dry-run",
    "flight-recorder:qa-seed": "node --env-file=.env.local --import tsx scripts/seed-flight-recorder-qa.ts",
    "flight-recorder:qa-reset": "node --env-file=.env.local --import tsx scripts/seed-flight-recorder-qa.ts --reset",
