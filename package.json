{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-start.mjs",
    "dev:raw": "next dev",
    "contacts:sync:prod": "bash scripts/contacts-sync.sh",
    "contacts:load:dev": "node --env-file=.env.local --import tsx scripts/load-apple-contacts.ts --env dev",
